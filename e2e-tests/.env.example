# =============================================================================
# FE-greenfield integration test secrets — copy to e2e-tests/.env and fill in.
#
# `e2e-tests/.env` is gitignored. Mirror the BE pattern at
# `checkitout-backend/.env`. The values below are placeholders — replace with
# real test-environment credentials for the Firebase project named in
# checkitout-backend/application-{dev,e2e}.yml (`firebase.project.id`).
#
# Loaded automatically by playwright.config.ts via the `dotenv` package
# when present. Absent .env → real-Firebase tests self-skip with a
# clear "credentials missing" message; mock-session tests continue
# to work unaffected.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Identity Toolkit (REST API) — used by real-login.ts to mint id
# tokens via signInWithPassword. Get the web API key from:
#   Firebase Console → Project Settings → General → Your apps → Web app config
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=

# Matches BE's app.firebase.project.id (e.g. "check-it-out-47c50" for test).
FIREBASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# Test user credentials — provision these once in the Firebase project
# (Auth → Users → Add user). Each test in @login-real or
# @admin-2fa creates its own actor and resets BE-side state, so these
# can be shared across runs.
#
# Naming convention: `e2e-test-{role}@<your-test-domain>` keeps them
# clearly non-production.
# -----------------------------------------------------------------------------
FIREBASE_TEST_COMPANY_EMAIL=e2e-test-company@example.test
FIREBASE_TEST_COMPANY_PASSWORD=

FIREBASE_TEST_INFLUENCER_EMAIL=e2e-test-influencer@example.test
FIREBASE_TEST_INFLUENCER_PASSWORD=

FIREBASE_TEST_ADMIN_EMAIL=e2e-test-admin@example.test
FIREBASE_TEST_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Admin 2FA test — TOTP secret pre-provisioned in Firestore for the admin user.
#
# Must match the BE's `ADMIN_TEST_TOTP_SECRET` env var AND the value seeded
# via /test/auth/seed-admin-totp (or one-time provisioning script).
# The well-known test secret JBSWY3DPEHPK3PXP decodes to ASCII "Hello!" and
# is RFC 4226 / 6238 standard for examples. NEVER use in production.
# -----------------------------------------------------------------------------
E2E_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# -----------------------------------------------------------------------------
# Optional overrides for the local dev stack. Defaults are fine for the
# standard pm2-managed stack on Norbert's machine; override here for
# different host/port combinations.
# -----------------------------------------------------------------------------
# BE_URL=https://localhost:8080
# GREENFIELD_URL=https://localhost:4201
# LEGACY_URL=https://localhost:4200

# =============================================================================
# Firebase Admin + KMS bridge (e2e-tests/_framework/firebase-admin-bridge.ts)
# -----------------------------------------------------------------------------
# Unlocks admin-2FA flows by giving the FE Node test infrastructure direct
# read/decrypt access to Firestore `totpSecrets/{firebaseUid}` + the KMS
# `instagram-tokens` keyring. ONLY for tests under e2e-tests/_framework — never
# imported from src/app/. The bridge self-disables when service-account.json
# isn't reachable, so tests `test.skip()` cleanly on machines without creds.
#
# Precedence: cfg arg > E2E_GCP_SERVICE_ACCOUNT_JSON_PATH > GOOGLE_APPLICATION_CREDENTIALS
#   > ../checkitout-backend/src/main/resources/service-account.json (default).
# =============================================================================

# Absolute path to the BE service-account.json (gitignored, real credentials).
# Leave commented to use the cross-repo default location.
# E2E_GCP_SERVICE_ACCOUNT_JSON_PATH=/abs/path/to/service-account.json

# Test admin Firebase UID — used by step-up / 2FA scenarios to look up
# `totpSecrets/{uid}` in Firestore. Mirrors BE `ADMIN_FIREBASE_UID`.
ADMIN_FIREBASE_UID=85VJgS6shAWTqby4rHypN355RWv2

# GCP project + KMS overrides (defaults match BE application-test.yml).
# FIREBASE_PROJECT_ID=check-it-out-47c50
# E2E_KMS_LOCATION=europe-central2
# E2E_KMS_KEY_RING=instagram-tokens
# E2E_KMS_TOTP_KEY=totp-secrets-key
