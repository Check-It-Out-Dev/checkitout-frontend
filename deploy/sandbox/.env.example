# /opt/checkitout-sandbox/.env on the VPS. rollout.sh rewrites FE_TAG and BE_TAG on every deploy and keeps
# the previous file as .env.previous for rollback. Everything else is set once by the owner.
FE_TAG=sandbox
BE_TAG=main
BE_PROFILES=dev-lite,sandbox
SANDBOX_PORT=8090
BACKEND_MEM=1536m
UPLOADS_DIR=/opt/checkitout-sandbox/uploads
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# Also handed to the backend as its Postgres superuser password (dev-lite initialiser).
POSTGRES_PASSWORD=change-me-on-the-host

# Grafana Cloud (optional; `--profile logging`). Tokens live only here.
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=
PROM_URL=
PROM_USER=
PROM_TOKEN=
