{
  "name": "check-it-out-fe-greenfield",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "dev-cert": "node tools/dev-cert.mjs",
    "prestart": "node tools/dev-cert.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "build:check": "ng build --configuration=development --output-hashing=none --output-path=dist/build-check",
    "check:static": "npm run check:no-legacy-ui && npm run check:api-wrappers && npm run check:i18n-parity && npm run check:visual-fixture-coverage && npm run check:visual-baseline-freshness && npm run check:integration-cucumber-citation && npm run check:bdd-corpus && npm run check:component-pair-sync && npm run check:contract-coverage && npm run check:icon-subset && npm run check:input-labels && npm run check:i18n-cache-buster && npm run check:published-numbers && npm run check:workflow-env && npm run check:playwright-image-pin && npm run check:gate-parity",
    "check:full": "npm run check:static && npm run typecheck && npm run typecheck:e2e && npm run build:check && npm test -- --bail",
    "check:workflow-env": "node tools/ci/check-workflow-env.mjs",
    "check:playwright-image-pin": "node tools/ci/check-playwright-image-pin.mjs",
    "check:published-numbers": "node tools/check-published-numbers.mjs",
    "measure:counts": "node tools/measure-test-counts.mjs",
    "check:no-legacy-ui": "node tools/check-no-fuse.mjs",
    "check:api-wrappers": "node tools/check-api-wrappers.mjs",
    "check:i18n-parity": "node tools/check-i18n-parity.mjs",
    "check:i18n-cache-buster": "node tools/i18n-cache-buster.mjs --check",
    "check:gate-parity": "node tools/check-gate-parity.mjs",
    "check:visual-fixture-coverage": "node tools/check-visual-fixture-coverage.mjs",
    "check:visual-baseline-freshness": "node tools/check-visual-baseline-freshness.mjs",
    "check:integration-cucumber-citation": "node tools/check-integration-cucumber-citation.mjs",
    "check:bdd-corpus": "node tools/check-bdd-corpus-completeness.mjs",
    "check:component-pair-sync": "node tools/check-component-pair-sync.mjs",
    "check:contract-coverage": "node tools/check-contract-coverage.mjs",
    "test:sandbox": "playwright test e2e-tests/sandbox",
    "test:msw": "playwright test e2e-tests/msw",
    "test:perf": "node tools/run-perf.mjs",
    "test:reports": "node tools/ci/run-reports.mjs",
    "test:mutation": "stryker run",
    "perf:k6": "k6 run e2e-tests/perf/k6/demo-routes.js",
    "perf:k6:api": "k6 run e2e-tests/perf/k6/api-journeys.js",
    "test:visual": "playwright test e2e-tests/visual/",
    "test:visual:update": "playwright test e2e-tests/visual/ --update-snapshots && node tools/write-regen-tag.mjs",
    "test:integration": "playwright test e2e-tests/integration --project=chromium-desktop --retries=2 --workers=1",
    "test:parity": "playwright test e2e-tests/visual-parity",
    "test:component-pair-parity": "playwright test e2e-tests/visual-parity/phantom-sandbox-parity.spec.ts --project=chromium-desktop",
    "test:scenarios": "playwright test e2e-tests/scenarios",
    "test:bdd": "bddgen && playwright test --project=bdd --workers=1",
    "test:bdd:stack": "node tools/ensure-stack.mjs && npm run test:bdd",
    "openapi:cycle": "node tools/openapi-cycle.mjs",
    "openapi:cycle:fast": "node tools/openapi-cycle.mjs --skip-be",
    "stack:deps": "docker compose -f ../checkitout-backend/docker-compose-dev-redis.yml up -d postgres redis",
    "parity:capture": "node tools/capture-legacy-baseline.mjs",
    "test:e2e": "playwright test",
    "health": "pwsh -NoProfile -File scripts/health-check.ps1",
    "stack:up": "pm2 start ecosystem.config.cjs",
    "stack:down": "pm2 stop ecosystem.config.cjs",
    "stack:logs": "pm2 logs",
    "openapi:gen": "node -e \"require('fs').rmSync('src/app/api',{recursive:true,force:true})\" && openapi-generator-cli generate -i docs/openapi/openapi.json -g typescript-angular -o src/app/api --additional-properties=ngVersion=22.0.0,providedIn=root,stringEnums=true,serviceFileSuffix=.api,useSingleRequestParameter=true,withInterfaces=true,modelPropertyNaming=original,supportsES6=true,fileNaming=kebab-case,enumPropertyNaming=UPPERCASE && node tools/suppress-api-types.mjs",
    "prepare": "husky",
    "serve:ssr:checkitout-frontend": "node dist/check-it-out-fe-greenfield/server/server.mjs",
    "check:icon-subset": "node tools/subset-material-icons.mjs --check",
    "check:input-labels": "node tools/check-input-labels.mjs",
    "start:demo": "ng serve --configuration demo --ssl",
    "build:demo": "ng build --configuration demo",
    "build:sandbox": "ng build --configuration production,sandbox",
    "serve:demo": "node tools/serve-demo.mjs",
    "deploy:demo": "node tools/deploy-demo.mjs"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js@1": "1.14.4",
    "axios@1": "1.18.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "form-data@2": "2.5.6",
    "form-data@4": "4.0.6",
    "protobufjs@7": "7.6.5",
    "qs@6": "6.16.0",
    "shell-quote@1": "1.9.0",
    "uuid@11": "11.1.1",
    "uuid@8": "11.1.1",
    "uuid@9": "11.1.1",
    "websocket-driver@0": "0.7.5",
    "ws@8": "8.21.0"
  },
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.9",
    "@ngneat/transloco": "^6.0.4",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular-devkit/build-angular": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.8",
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@google-cloud/kms": "^6.0.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "allure-playwright": "3.12.0",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.9.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-cli": "^30.4.2",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "lint-staged": "^17.0.2",
    "msw": "^2.15.0",
    "ng-mocks": "^14.15.2",
    "playwright-bdd": "^9.2.1",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "simple-icons": "^16.30.0",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3"
  },
  "msw": {
    "workerDirectory": [
      "src"
    ]
  }
}
