/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"]
  },
  "files": ["src/main.ts", "src/main.server.ts", "server.ts"],
  // src/testing carries the L0 contract-assertion files — they must ride
  // `npm run typecheck` (this config) so codegen/wrapper drift fails the
  // gate. Specs are excluded; jest's tsconfig owns those.
  "include": ["src/**/*.d.ts", "src/testing/**/*.ts"],
  "exclude": ["src/testing/**/*.spec.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
