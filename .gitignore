# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# System files
.DS_Store
Thumbs.db

# Generated OpenAPI client (src/app/api) is GIT-TRACKED (owner directive
# 2026-09-02): drift shows up in diffs and a fresh clone compiles without
# codegen. Source of truth stays ../checkitout-backend/docs/openapi/openapi.json;
# `npm run openapi:gen` clean-regenerates the whole dir.

# OpenAPI generator cache (Java JAR + version metadata)
/.openapi-generator-cli/
/openapitools.json.lock
**/.openapi-generator/

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# Stage-5a screenshot-review captures — regenerated locally via
# tools/capture-greenfield-actual.mjs. Not committed because PNGs balloon
# the repo and the review markdown in docs/parity-review/ is the deliverable.
/e2e-tests/visual-parity/greenfield-actuals/

# Local test secrets — Firebase API key, test-user credentials, TOTP secret.
# `.env.example` is committed as a template; `.env` is never. Mirrors the
# checkitout-backend/.env pattern. See e2e-tests/.env.example.
.env
.env.local
.env.*.local
e2e-tests/.env
e2e-tests/.env.local
firebase-test-config.json
# Defense-in-depth: never accept a service-account.json checked into the
# FE repo. The Firebase Admin bridge (e2e-tests/_framework/firebase-admin-
# bridge.ts) reads it from the BE repo via path; this gitignore line
# fires if anyone copies the file locally for convenience.
service-account.json
service-account*.json
e2e-tests/service-account*.json
e2e-tests/.firebase-admin-cache/
firebase-test-*.json
.features-gen/

# Local HTTPS certificate for the dev-server (angular.json sslKey/sslCert).
# Generated by tools/dev-cert.mjs on `npm start` — every clone gets its own.
# Never committed: a private key in a public repository reads as a leak
# regardless of how worthless a localhost key actually is.
/server.key
/server.crt

# cutover secrets (keys live only locally)
deployment/vps/.env.cutover
deployment/vps/cutover-log-*.txt

# Visual-QA capture. `npm run test:perf -- e2e-tests/perf/film.spec.ts` writes a
# few hundred MB of frames, movies and DOM traces per run; the reports derived
# from them are what gets written up, never the footage.
/qa-film/
/qa-shots/

# k6 summaries (one JSON per run)
e2e-tests/perf/k6/results/

# Reports written by the Kubernetes test-execution substrate (deploy/k8s), collected through the kind mount
ci-reports/

# Anything `gh run download` leaves behind. A downloaded backend.log was swept into a public
# commit by `git add -A` because the download ran with the working directory inside the repo;
# nothing in a run artifact belongs in git, and the run's own log is already public anyway.
*.log
backend-log-*/
nightly-blob-*/
nightly-report-*/
# Allure 3: results merged out of the Playwright blobs, the generated report, and the history file
# the CI jobs carry on the Pages site. All three are build output.
allure-results/
allure-report/
history.jsonl

# Stryker mutates the working tree in place (see stryker.conf.json for why it has to) and
# keeps its backup here; the reports are derived from a run and belong to the artifact, not
# to the repository.
.stryker-tmp/
reports/

# Firebase emulator debug logs, written wherever the emulator is started from.
firebase-debug.log
firestore-debug.log
ui-debug.log
